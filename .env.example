# Local development configuration. Copy to .env — never commit secrets.
SERVICE_ENV=development
HTTP_ADDR=:8080
SERVICE_LOG_LEVEL=debug

DATABASE_URL=postgres://identity:identity@localhost:5432/identity?sslmode=disable
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_IDENTITY_EVENTS=identity_events

RESEND_API_KEY=re_development_placeholder
MAIL_FROM=identity@example.com
APP_BASE_URL=http://localhost:3000

JWT_ISSUER=identity_service
JWT_AUDIENCE=community_platform
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
SIGNING_KEY_ROTATION_INTERVAL=720h
SIGNING_KEY_ROTATION_OVERLAP=1h

LOGIN_MAX_FAILURES=5
LOGIN_SOURCE_MAX_FAILURES=20
LOGIN_WINDOW=15m
LOGIN_LOCKOUT=15m

SHUTDOWN_TIMEOUT=20s
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
